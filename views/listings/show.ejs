<% layout("layouts/boilerplate") -%>
    <div class="row mt-3">
        <div class="col-8 offset-3">


            <body>
                <h3>
                    <%= listing.title %>
                </h3>
        </div>

        <div class="card col-6 offset-3 show-card">
            <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing_image">
            <div class="card-body">
                <p class="card-text">
                    <br> <br>
                    <%= listing.description %> <br>
                        &#8377; <%= listing.price.toLocaleString("en-In") %> <br>
                            <%= listing.location %> <br>
                                <%= listing.country %>
                </p>
            </div>
        </div>

    </div>
    <div class="btns">
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark col-1 offset-3 edit-btn">Edit</a>

        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE"><button
                class="btn btn-dark offset-5">Delete</button>
        </form>
    </div>
    <div class="col-8 offset-3 mb-3">
        <hr>
        <h4>Leave a Review</h4>
        <form action="/listings/<%=listing.id%>/reviews" method="POST" novalidate class="needs-validation">
            <div class="mb-3 mt-3">
                <label for="rating" class="form-label">Rating</label>
                <input type="range" name="review[rating]" id="rating" min="1" max="5" class="form-range">
            </div>
            <div class="mb-3 mt-3">
                <label for="comment" class="form-label">Comment</label>
                <textarea name="review[comment]" id="comment" cols="20" rows="5" class="form-control"
                    required></textarea>
                <div class="invalid-feedback">Please add some comment for review</div>
            </div>
            <button type="submit" class="btn btn-outline-dark">Submit Review</button>
        </form>
    </div>
    </body>